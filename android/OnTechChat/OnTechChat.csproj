<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <ApplicationId>com.ontechdev.chat</ApplicationId><ApplicationTitle>온테크 채팅</ApplicationTitle>
    <ApplicationVersion>184</ApplicationVersion><ApplicationDisplayVersion>1.8.4</ApplicationDisplayVersion>
    <RuntimeIdentifier>android-arm64</RuntimeIdentifier><AndroidPackageFormats>apk</AndroidPackageFormats>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk><AndroidEnableFastDeployment>false</AndroidEnableFastDeployment>
    <RunAOTCompilation>false</RunAOTCompilation><PublishTrimmed>false</PublishTrimmed>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Xamarin.Firebase.Messaging" Version="125.1.3" />
    <GoogleServicesJson Include="google-services.json" />
  </ItemGroup>
</Project>

